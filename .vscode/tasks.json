{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build ClubWeb",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}\\ClubWeb\\ClubWeb.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test ClubWeb",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}\\ClubWeb.Tests\\ClubWeb.Tests.csproj"
      ],
      "group": "test",
      "problemMatcher": "$msCompile"
    }
  ]
}
