@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
    <div class="shell header-content">
        <a class="brand" href="/projects">GMU Microsoft Club <span>Project space</span></a>
        <nav aria-label="Main navigation">
            <NavLink href="projects">Projects</NavLink>
        </nav>
    </div>
</header>

<main id="main-content" class="shell" tabindex="-1">
    @Body
</main>
<footer class="shell">A small Blazor frontend for the ClubApi workshop. Learning app, not production-secured.</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
